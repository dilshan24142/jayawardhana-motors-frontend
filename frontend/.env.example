# Copy this file to .env and fill in your own values. Never commit .env.
# Only variables starting with VITE_ are available in the browser, so never put secrets here.

# Backend API base URL
VITE_API_URL=http://localhost:4000/api/v1

# Firebase web app config (JM-06). From Firebase console > Project settings > Your apps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
